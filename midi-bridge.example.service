[Unit]
Description=MIDI Bridge for pi-stomp
After=mod-ui.service
Wants=mod-ui.service

[Service]
Type=simple
User=pistomp
Restart=on-failure
RestartSec=5

# Point the working directory to where the repository was cloned
WorkingDirectory=/home/pistomp/pistomp-midi-bridge

# NOTE: this assumes that config.json is in the same working directory, and
# that `uv sync --frozen` has already been run in WorkingDirectory to create
# .venv/ (see README). Calling the venv's console script directly means no
# uv invocation, no dependency resolution and no network access at boot.
ExecStart=/home/pistomp/pistomp-midi-bridge/.venv/bin/pistomp-midi-bridge --config config.json

[Install]
WantedBy=multi-user.target
